# Dedicated PostgreSQL database for the ticket subsystem.
# Add the real value in Replit Secrets, never commit it.
TICKET_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/packsmptickets

# Optional: explicit Discord channel/category IDs. If omitted, the bot searches by name.
DISCORD_TICKET_LOG_CHANNEL_ID=
DISCORD_TICKET_ARCHIVE_CATEGORY_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_TICKET_REKRUTACJA_CATEGORY_ID=
DISCORD_TICKET_SOJUSZ_CATEGORY_ID=
DISCORD_TICKET_KONKURS_CATEGORY_ID=
DISCORD_TICKET_WSPARCIE_CATEGORY_ID=
DISCORD_TICKET_EVENT_CATEGORY_ID=
DISCORD_TICKET_WALKA_CATEGORY_ID=
DISCORD_TICKET_INNE_CATEGORY_ID=
DISCORD_TICKET_IMPORTANT_CATEGORY_ID=
DISCORD_TICKET_STAGE1_CATEGORY_ID=
DISCORD_TICKET_STAGE2_CATEGORY_ID=
DISCORD_TICKET_STAGE3_CATEGORY_ID=

# Role with access to every ticket.
DISCORD_TICKET_STAFF_ROLE_IDS=1534975728263626853
